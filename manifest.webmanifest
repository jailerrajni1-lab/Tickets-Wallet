{
  "id": "./",
  "name": "Wallet - Ticket Analyser",
  "short_name": "Wallet",
  "description": "Read KSRTC bus and IRCTC train tickets and keep them handy with your ID proof.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f4efe6",
  "theme_color": "#f4efe6",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "ticket",
          "accept": [
            "application/pdf",
            "image/*",
            ".pdf"
          ]
        }
      ]
    }
  },
  "categories": [
    "travel",
    "utilities"
  ],
  "shortcuts": [
    {
      "name": "Saved tickets",
      "short_name": "Tickets",
      "url": "./?tab=tickets"
    },
    {
      "name": "ID cards",
      "short_name": "ID cards",
      "url": "./?tab=ids"
    }
  ]
}
